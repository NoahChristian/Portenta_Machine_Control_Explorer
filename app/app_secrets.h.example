/*
 * Template for app/app_secrets.h. Copy, then fill in.
 *
 * PLACEHOLDERS ONLY. This file is generated by blanking every value, NEVER by
 * copying a working app_secrets.h - a real value pasted into an example is how
 * credentials reach a public repository, and no secret scanner catches it.
 *
 * NOTE WHAT THIS FILE IS NOT. Nothing #includes it and no value here is
 * compiled into the firmware. tools/wifi_provision.ps1 reads it once and
 * pushes the credentials into the board's NVS over the USB shell, where they
 * live in the kvs partition - outside both image slots, so they survive every
 * firmware update. The consequence worth knowing: a leaked .bin leaks no
 * credential, and an OTA image cannot carry one somewhere it should not go.
 */
#pragma once

/* The 2.4 GHz network the board joins.
 *
 * The CYW4343W is 802.11 b/g/n ONLY. A 5 GHz-only SSID will never be found,
 * however correct the passphrase is - check this before debugging the
 * credential. */
#define SECRET_SSID ""

/* WPA2-PSK passphrase. That is key management type 1 in `wifi cred add -k`. */
#define SECRET_PASS ""

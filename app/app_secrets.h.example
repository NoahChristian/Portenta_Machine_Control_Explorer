/*
 * Template for app/app_secrets.h. Copy, then fill in. Placeholders only.
 *
 * Read by tools/wifi_provision.ps1 and tools/token_provision.ps1, which push
 * these values into the board's NVS over the USB shell. NOTHING HERE IS
 * COMPILED INTO THE FIRMWARE, and as of 0.8.0 that is finally true of all
 * three: the token used to be a build input, which put it in the image as
 * plain ASCII. See docs/PROVISIONING.md.
 *
 * So this file is not a build input at all. Editing it changes nothing until
 * a provisioning script is run, and a rebuild is never the way to apply it.
 */
#pragma once

/* 2.4 GHz only: the CYW4343W will never find a 5 GHz-only SSID. */
#define SECRET_SSID ""

/* WPA2-PSK passphrase. */
#define SECRET_PASS ""

/*
 * 16 to 64 characters (PMC_AUTH_TOKEN_MIN/_MAX in app/src/auth.h); the board
 * refuses anything outside that. Empty here, or never provisioned, means
 * every write is refused - the safe default.
 *
 *     pwsh tools/token_provision.ps1 -Generate
 *
 * fills this in and stores it on the board in one step.
 */
#define SECRET_API_TOKEN ""

# Which physical board the flashing tools may write to. Copy to
# tools/bench.local.ps1, which is gitignored because a unique device ID
# identifies a device.
#
# The USB serial from `dfu-util -l`. DFU performs no signature check, so a
# wrong value here overwrites another board's bootloader. Run
# tools/install_mcuboot.ps1 with no bench file and it prints the serial it
# found and refuses to write. See docs/OTA.md.

$PMC_DFU_SERIAL = ''

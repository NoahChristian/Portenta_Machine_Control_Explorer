# .gitignore is only the first layer: it is per-branch and `git add -f` walks
# past it. The content checks are in tools/pre-commit.

# Credentials
app_secrets.h
arduino_secrets.h
secrets.h

# Which board this bench may flash
tools/bench.local.ps1

# Signing keys, and the fragments naming their absolute paths
*.pem
*.key
*.priv
mcuboot/pmc-key.conf
app/mcuboot-key.conf

# Firmware images, by extension and not only by directory
*.bin
*.elf
*.map
*.hex
*.signed.bin
*.signed.hex

# Build trees
build/
build-*/
twister-out*/
__pycache__/
*.pyc

# Captures and scratch
captures/
*.rtt
*.log
~$*

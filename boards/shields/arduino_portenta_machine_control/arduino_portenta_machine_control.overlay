 *
 * The reasoning behind every node here is in docs/SHIELD.md, under the same
 * node names. The hardware facts themselves are split by how well they are
 * known: docs/HARDWARE_FROM_MANUAL.md, docs/INFERRED_FROM_MBED.md and
 * docs/MEASURED.md.
 */

#include <zephyr/dt-bindings/pwm/pwm.h>

/ {
	/* AI0, AI1, AI2 in panel order: PC_3C, PC_2C, PA_1C. */
	zephyr,user {
		io-channels = <&adc3 1>, <&adc3 0>, <&adc1 1>;
	};
};

/* The board definition enables NO ADC at all, so both are turned on here.
 * SYNC clock with a prescaler of 4; see docs/SHIELD.md. */
&adc12_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

&adc3_common {
	st,adc-clock-source = "SYNC";
	st,adc-prescaler = <4>;
	status = "okay";
};

/* AI2, on PA_1C. The SYSCFG analog switch for PA1 must be open or this reads
 * the Ethernet RMII clock - see pmc_syscfg.c. */
&adc1 {
	pinctrl-0 = <&adc1_inp1_pa1_c>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};
};

/* AI0 and AI1, on PC_3C and PC_2C - shared with the temperature SPI bus
 * unless those analog switches are open too. */
&adc3 {
	pinctrl-0 = <&adc3_inp0_pc2_c &adc3_inp1_pc3_c>;
	pinctrl-names = "default";
	status = "okay";
	#address-cells = <1>;
	#size-cells = <0>;

	channel@0 {
		reg = <0>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};

	channel@1 {
		reg = <1>;
		zephyr,gain = "ADC_GAIN_1";
		zephyr,reference = "ADC_REF_INTERNAL";
		zephyr,acquisition-time = <ADC_ACQ_TIME_DEFAULT>;
		zephyr,resolution = <16>;
	};
};

&i2c1 {
	pmc_rtc: pcf8563@51 {
		compatible = "nxp,pcf8563";
		reg = <0x51>;
		status = "okay";
	};
};

/*
 * The encoder inputs. Declared as gpio-keys purely to give each line a
 * nodelabel and a GPIO spec; no input driver is enabled, so nothing else
 * claims them and enc.c takes them directly with GPIO_DT_SPEC_GET.
 *
 * NEITHER ENCODER CAN USE THE STM32's HARDWARE QUADRATURE DECODER, and that
 * is a fact about this package rather than a choice. Encoder mode needs
 * channels 1 and 2 of ONE timer on A and B. Checked against
 * stm32h747xihx-pinctrl.dtsi, which is the authority on what this silicon can
 * do:
 *
 *   ENC0  A PJ8  = tim8_ch1       B PH12 = tim5_ch3    different timers,
 *                                                      and CH3, not CH2
 *   ENC1  A PC13 = analog ONLY    B PI7  = tim8_ch3    PC13 has no timer
 *                                                      function at all
 *
 * PC13 is the striking one: it carries no alternate function whatsoever on
 * this package. It is a backup-domain pin and it can only ever be a GPIO
 * here. So both channels are decoded in software from GPIO interrupts - see
 * app/src/enc.c for what that costs and where it stops working.
 *
 * This is the same shape as AO2 below, and was found the same way: grep the
 * pinctrl file before writing a line of driver code.
 */
/ {
	pmc_encoder_in: pmc-encoder-in {
		compatible = "gpio-keys";
		enc0a: enc0a { gpios = <&gpioj 8  GPIO_ACTIVE_HIGH>; label = "ENC0 A"; };
		enc0b: enc0b { gpios = <&gpioh 12 GPIO_ACTIVE_HIGH>; label = "ENC0 B"; };
		enc0z: enc0z { gpios = <&gpioh 11 GPIO_ACTIVE_HIGH>; label = "ENC0 Z"; };
		enc1a: enc1a { gpios = <&gpioc 13 GPIO_ACTIVE_HIGH>; label = "ENC1 A"; };
		enc1b: enc1b { gpios = <&gpioi 7  GPIO_ACTIVE_HIGH>; label = "ENC1 B"; };
		enc1z: enc1z { gpios = <&gpioj 10 GPIO_ACTIVE_HIGH>; label = "ENC1 Z"; };
	};
};

/* AO0 and AO1 on TIM1. There is no AO2 here: PG_7 has no timer channel on
 * this package, so it cannot be driven by PWM at all. */
&timers1 {
	st,prescaler = <0>;
	status = "okay";

	pwm_ao01: pwm {
		status = "okay";
		pinctrl-0 = <&tim1_ch1_pk1 &tim1_ch2_pj11>;
		pinctrl-names = "default";
	};
};

/* AO3 on TIM3. */
&timers3 {
	st,prescaler = <0>;
	status = "okay";

	pwm_ao3: pwm {
		status = "okay";
		pinctrl-0 = <&tim3_ch2_pc7>;
		pinctrl-names = "default";
	};
};

/* 50 us period, i.e. 20 kHz, for the RC filter that turns each PWM into a
 * voltage. The channel numbers are timer channels, not AO numbers. */
/ {
	pmc_ao: pmc-ao {
		compatible = "pwm-leds";
		ao0: ao0 { pwms = <&pwm_ao01 2 PWM_USEC(50) PWM_POLARITY_NORMAL>; };
		ao1: ao1 { pwms = <&pwm_ao01 1 PWM_USEC(50) PWM_POLARITY_NORMAL>; };
		ao3: ao3 { pwms = <&pwm_ao3  2 PWM_USEC(50) PWM_POLARITY_NORMAL>; };
	};
};

/* THE EXPANDERS ARE ON i2c3, MEASURED - not i2c1 as the mbed library implies.
 * 0x22 carries the 12 programmable channels, 0x23 the 8 digital inputs. DIN
 * and PDIO are expander bits, not MCU pads. */
&i2c3 {
	status = "okay";

	pmc_pdio_expander: tca6424a@22 {
		compatible = "ti,tca6424a";
		reg = <0x22>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <24>;
		status = "okay";
	};

	pmc_din_expander: tca6424a@23 {
		compatible = "ti,tca6424a";
		reg = <0x23>;
		gpio-controller;
		#gpio-cells = <2>;
		ngpios = <24>;
		status = "okay";
	};
};

/*
 * The temperature bus. Two converters, three devicetree instances.
 *
 * NSS is dropped from pinctrl on purpose: PI_0 is the thermocouple chip
 * select and has to be an ordinary GPIO. And PA6 appears TWICE in cs-gpios
 * because there is one MAX31865 and two instances of it - pmc_rtd for 2- or
 * 4-wire and pmc_rtd_3w for 3-wire, selected at runtime.
 */
&spi2 {
	pinctrl-0 = <&spi2_sck_pi1 &spi2_miso_pc2 &spi2_mosi_pc3>;
	pinctrl-names = "default";
	cs-gpios = <&gpioi 0 GPIO_ACTIVE_LOW>,
		   <&gpioa 6 GPIO_ACTIVE_LOW>,
		   <&gpioa 6 GPIO_ACTIVE_LOW>;
	status = "okay";

	pmc_tc: max31855@0 {
		compatible = "maxim,max31855";
		reg = <0>;
		spi-max-frequency = <4000000>;
		status = "okay";
	};

	/* PT100 and the 400 ohm reference its datasheet recommends. A PT1000
	 * would need 1000 and 4000, and getting it wrong gives a steady,
	 * plausible reading with no fault bit. 60 Hz notch, by OMITTING
	 * filter-50hz - note that property has no vendor prefix. */
	pmc_rtd: max31865@1 {
		compatible = "maxim,max31865";
		reg = <1>;
		spi-max-frequency = <4000000>;
		resistance-at-zero = <100>;
		resistance-reference = <400>;
		status = "okay";
	};

	/* The same chip again, 3-wire. maxim,3-wire DOES carry the prefix. */
	pmc_rtd_3w: max31865@2 {
		compatible = "maxim,max31865";
		reg = <2>;
		spi-max-frequency = <4000000>;
		resistance-at-zero = <100>;
		resistance-reference = <400>;
		maxim,3-wire;
		status = "okay";
	};
};

/* RS485/RS232 through the SP335. No de-enable: UART4's hardware DE exists
 * only on PA15 or PB14 in this package and this carrier routes DE to PI_13,
 * so the turnaround is done in software. See rs485.c. */
&uart4 {
	status = "okay";
	current-speed = <19200>;
};

/* Ethernet on J13, as a second path so the update path does not depend on the
 * radio. Working at 100 Mbit full duplex - see docs/MEASURED.md. */
&mac {
	status = "okay";
};

/*
 * CAN on the HMI connector, through FDCAN1.
 *
 * TX AND RX ARE THE OTHER WAY ROUND FROM THE mbed LIBRARY. pins_mc.h records
 * "CAN TX PB_8 RX PH_13"; this package's pinctrl offers only fdcan1_RX on PB8
 * and only fdcan1_TX on PH13, with no second FDCAN function on either. The
 * silicon's table wins over another program's header, and the pad column in
 * tools/terminals.csv has been corrected to match. Marked [MBED] wherever it
 * is repeated, because it is still unconfirmed at the connector: nothing has
 * yet put a frame on a wire and watched it arrive.
 *
 * Classic CAN, not CAN FD. The carrier's transceiver, the 120 ohm termination
 * and every dongle likely to be on this bench are classic; FD would also need
 * a data-phase bitrate nobody has specified. The controller is FD-capable and
 * turning it on later is a Kconfig and a second timing block.
 */
&fdcan1 {
	status = "okay";
	pinctrl-0 = <&fdcan1_rx_pb8 &fdcan1_tx_ph13>;
	pinctrl-names = "default";
	bitrate = <500000>;
	sample-point = <875>;
};

/* The PHY sources the RMII reference clock, and its PLL has to lock before
 * the MAC resets itself. Honored by regulator_fixed.c with a k_usleep. */
&ethernet_phy_en {
	startup-delay-us = <50000>;
};
